# Copy to .env and fill in. Never commit .env.

# --- Database (VPS) ---
POSTGRES_DB=plc
POSTGRES_USER=plc
# URL-safe characters only (it is embedded in DATABASE_URL)
POSTGRES_PASSWORD=change-me-long-random

# --- API (VPS) ---
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=change-me-app-key-min-16-chars
INGEST_API_KEY=change-me-ingest-key-min-16-chars
HEARTBEAT_INTERVAL_S=60
SOURCE_LABELS=plc_line_2=Line 2
DISPLAY_TZ=Africa/Tunis
SHIFT_NAMES=A,B,C
SHIFT_START=06:00
API_BIND=127.0.0.1
API_PORT=8000
# Public hostname for HTTPS (profile "https"), DNS A record -> VPS IP
DOMAIN=api.example.com

# --- Collector (factory LAN machine) ---
# snap7 = real PLC, fake = simulated counter
PLC_READER=snap7
PLC_IP=192.168.1.81
PLC_RACK=0
PLC_SLOT=1
# source:AREA:DB:OFFSET:TYPE ; ...   AREA=MK|DB|PE|PA  TYPE=DINT|INT|DWORD|WORD|BYTE
TAGS=plc_line_2:MK:0:10:DINT
POLL_INTERVAL_MS=200
API_URL=https://api.example.com
API_VERIFY_TLS=true
FAKE_RATE_PER_MIN=24
FAKE_DISCONNECT_PROB=0
LOG_LEVEL=INFO
